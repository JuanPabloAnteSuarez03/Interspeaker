# Backend - Flask
FLASK_ENV=production
FLASK_APP=app.py

# Gemini 2.5 Flash (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud STT / TTS (service account JSON con rol Cloud Speech Client)
GOOGLE_APPLICATION_CREDENTIALS=Backend/google-credentials.json
STT_LANGUAGE_CODE=es-ES
STT_SAMPLE_RATE_HERTZ=48000
STT_MIN_AUDIO_BYTES=500
# SKIP_STT=1          # fuerza modo stub (tests/CI)
# STT_LIVE_IN_CI=1    # usar Google STT real en GitHub Actions

# Frontend - Vite
VITE_API_URL=http://localhost:5100
